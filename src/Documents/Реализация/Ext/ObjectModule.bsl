#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Очищаем старые движения документа перед расчетом остатков
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.Записать();
	
	// 2. Создаем запрос для проверки остатков на складе на момент проведения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТовары.Товар КАК Товар,
		|	СУММА(РеализацияТовары.Количество) КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Реализация.Товары КАК РеализацияТовары
		|ГДЕ
		|	РеализацияТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТовары.Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТоварыДокумента.Товар КАК Товар,
		|	ВТ_ТоварыДокумента.Товар.Представление КАК ТоварПредставление,
		|	ВТ_ТоварыДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
		|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК КоличествоНаСкладе
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ_ТоварыДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&МоментВремени, ) КАК ОстаткиТоваровОстатки
		|		ПО ВТ_ТоварыДокумента.Товар = ОстаткиТоваровОстатки.Товар";
		
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	// Берем МоментВремени, чтобы учесть документы, проведенные в эту же секунду
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	// 3. Анализируем остатки и выдаем ошибки при нехватке
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КоличествоВДокументе > Выборка.КоличествоНаСкладе Тогда
			
			Нехватка = Выборка.КоличествоВДокументе - Выборка.КоличествоНаСкладе;
			
			// Понятное сообщение для пользователя
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Недостаточно товара ""%1"" на складе! Требуется: %2, В наличии: %3 (Нехватка: %4)", 
				Выборка.ТоварПредставление, Выборка.КоличествоВДокументе, Выборка.КоличествоНаСкладе, Нехватка);
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// 4. Если остатков хватает (Отказ остался Ложь) — формируем расходные движения
	Если Не Отказ Тогда
		
		Для Каждого СтрокаТоваров Из Товары Цикл
			
			ДвижениеОстатковТоваров = Движения.ОстаткиТоваров.ДобавитьРасход();
			ДвижениеОстатковТоваров.Период = Дата;
			ДвижениеОстатковТоваров.Товар = СтрокаТоваров.Товар;
			ДвижениеОстатковТоваров.Количество = СтрокаТоваров.Количество;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

