	Процедура ОбработкаПроведения(Отказ, РежимПроведения)			#Область ПодготовкаДвиженийИБлокировка	Движения.ОстаткиТоваров.Записывать = Истина;	Движения.ОстаткиТоваров.Очистить();		Движения.Продажи.Записывать = Истина;	Движения.Продажи.Очистить();		КонтролироватьОстатки = (РежимПроведения = РежимПроведенияДокумента.Оперативный);		Для Каждого ТекСтрока Из Товары Цикл		Движение = Движения.ОстаткиТоваров.ДобавитьРасход();		Движение.Период = Дата;		Движение.Товар = ТекСтрока.Товар;		Движение.Количество = ТекСтрока.Количество;	КонецЦикла;		Движения.ОстаткиТоваров.Записать();		Блокировка = Новый БлокировкаДанных;	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");	ЭлементБлокировки.ИсточникДанных = Товары;	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");	Блокировка.Заблокировать();	#КонецОбласти		#Область ФормированиеЗапроса	МенеджерВТ = Новый МенеджерВременныхТаблиц;	Запрос = Новый Запрос;	Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 		Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	СУММА(РеализацияТовары.Количество) КАК Количество,
	|	СУММА(РеализацияТовары.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТоварыДокумента
	|ИЗ
	|	Документ.Реализация.Товары КАК РеализацияТовары
	|ГДЕ
	|	РеализацияТовары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТовары.Товар";
			Запрос.УстановитьПараметр("Ссылка", Ссылка);	Запрос.Выполнить(); 		Запрос.Текст = 	"ВЫБРАТЬ	|       ВТ.Товар КАК Товар,	|       ВТ.Количество КАК КоличествоВДокументе,	|       ВТ.Сумма КАК СуммаВДокументе,	|       ЕСТЬNULL(ОстаткиМинус.КоличествоОстаток, 0) КАК КоличествоМинусОстаток,	|       ОстаткиПартий.Партия КАК Партия,	|       ЕСТЬNULL(ОстаткиПартий.КоличествоОстаток, 0) КАК КоличествоПартии,	|       ЕСТЬNULL(ОстаткиПартий.СтоимостьОстаток, 0) КАК СтоимостьПартии	|ИЗ	|       ВТ_ТоварыДокумента КАК ВТ	|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&МоментВремени, Товар В (
	|       ВЫБРАТЬ 
	|       ВТ_ТоварыДокумента.Товар 
	|       ИЗ 
	|       ВТ_ТоварыДокумента)) КАК ОстаткиМинус 	|       ПО ВТ.Товар = ОстаткиМинус.Товар И (ОстаткиМинус.КоличествоОстаток < 0)	|       ЛЕВОЕ СОЕДИНЕНИЕ	|       РегистрНакопления.ОстаткиТоваров.Остатки(&МоментДО, Товар В (
	|       ВЫБРАТЬ 
	|       ВТ_ТоварыДокумента.Товар 
	|       ИЗ
	|       ВТ_ТоварыДокумента)) КАК ОстаткиПартий 	|       ПО ВТ.Товар = ОстаткиПартий.Товар 	|УПОРЯДОЧИТЬ ПО	|       Товар,	|       ОстаткиПартий.Партия.Дата ВОЗР";		Запрос.УстановитьПараметр("МоментВремени", МоментВремени());	Запрос.УстановитьПараметр("МоментДО", Новый Граница(МоментВремени(), ВидГраницы.Исключая));	РезультатЗапроса = Запрос.Выполнить();	ВыборкаТоваров = РезультатЗапроса.Выбрать();	Движения.ОстаткиТоваров.Очистить(); 	#КонецОбласти		#Область РаспределениеПартийИКонтрольОстатков	Пока ВыборкаТоваров.СледующийПоЗначениюПоля("Товар") Цикл				// Если включен оперативный контроль и количество ушло в минус — отказываем в проведении		Если КонтролироватьОстатки И ВыборкаТоваров.КоличествоМинусОстаток < 0 Тогда						Нехватка = -ВыборкаТоваров.КоличествоМинусОстаток;						Сообщение = Новый СообщениеПользователю;			Сообщение.Текст = "Недостаточно товара " + ВыборкаТоваров.Товар + "! Не хватает: " + Нехватка;			Сообщение.Сообщить(); 						Отказ = Истина;		КонецЕсли;				Если Отказ Тогда			Продолжить;		КонецЕсли;				КоличествоКСписанию = ВыборкаТоваров.КоличествоВДокументе;		НакопленнаяСебестоимость = 0;				ЦиклПоПартиям = Истина;		Пока ЦиклПоПартиям И КоличествоКСписанию > 0 Цикл						ОстатокВПартии = ВыборкаТоваров.КоличествоПартии;			СтоимостьВПартии = ВыборкаТоваров.СтоимостьПартии;						Если ОстатокВПартии = 0 Тогда				Прервать;			КонецЕсли;						ВзятьИзПартии = Мин(КоличествоКСписанию, ОстатокВПартии);						Если ВзятьИзПартии = ОстатокВПартии Тогда				СписываемаяСтоимость = СтоимостьВПартии;			Иначе				СписываемаяСтоимость = (СтоимостьВПартии / ОстатокВПартии) * ВзятьИзПартии;			КонецЕсли;						// Регистр ОстаткиТоваров			ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();			ДвижениеОстатки.Период = Дата;			ДвижениеОстатки.Товар = ВыборкаТоваров.Товар;			ДвижениеОстатки.Партия = ВыборкаТоваров.Партия;			ДвижениеОстатки.Количество = ВзятьИзПартии;			ДвижениеОстатки.Стоимость = СписываемаяСтоимость;						НакопленнаяСебестоимость = НакопленнаяСебестоимость + СписываемаяСтоимость;			КоличествоКСписанию = КоличествоКСписанию - ВзятьИзПартии;						Если КоличествоКСписанию > 0 Тогда				ЦиклПоПартиям = ВыборкаТоваров.Следующий();			КонецЕсли;					КонецЦикла;				// Если мы проводим документ НЕоперативно, и партий не хватило 		Если КоличествоКСписанию > 0 Тогда			ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();			ДвижениеОстатки.Период = Дата;			ДвижениеОстатки.Товар = ВыборкаТоваров.Товар;			ДвижениеОстатки.Количество = КоличествоКСписанию;		КонецЕсли;				// Регистр «Продажи»		ДвижениеПродажи = Движения.Продажи.Добавить();		ДвижениеПродажи.Период = Дата;		ДвижениеПродажи.Товар = ВыборкаТоваров.Товар;		ДвижениеПродажи.Контрагент = Контрагент;		ДвижениеПродажи.Количество = ВыборкаТоваров.КоличествоВДокументе;				ДвижениеПродажи.Сумма = ВыборкаТоваров.СуммаВДокументе; 		ДвижениеПродажи.Себестоимость = НакопленнаяСебестоимость; 			КонецЦикла;	#КонецОбластиКонецПроцедуры