	Процедура ОбработкаПроведения(Отказ, РежимПроведения)		#Область ПодготовкаДвиженийИБлокировка	Движения.ОстаткиТоваров.Записывать = Истина;	Движения.Продажи.Записывать = Истина;		КонтролироватьОстатки = (РежимПроведения = РежимПроведенияДокумента.Оперативный);		Блокировка = Новый БлокировкаДанных;	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");	ЭлементБлокировки.ИсточникДанных = Товары;	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");	Блокировка.Заблокировать();	#КонецОбласти		#Область ФормированиеЗапроса	МенеджерВТ = Новый МенеджерВременныхТаблиц;	Запрос = Новый Запрос;	Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 		Запрос.Текст = 	"ВЫБРАТЬ	|	РеализацияТовары.Товар КАК Товар,	|	СУММА(РеализацияТовары.Количество) КАК Количество,	|	СУММА(РеализацияТовары.Сумма) КАК Сумма	|ПОМЕСТИТЬ ВТ_ТоварыДокумента	|ИЗ	|	Документ.Реализация.Товары КАК РеализацияТовары	|ГДЕ	|	РеализацияТовары.Ссылка = &Ссылка	|СГРУППИРОВАТЬ ПО	|	РеализацияТовары.Товар";			Запрос.УстановитьПараметр("Ссылка", Ссылка);	Запрос.Выполнить(); 		Запрос.Текст = 	"ВЫБРАТЬ	|	ВТ.Товар КАК Товар,	|	ВТ.Количество КАК КоличествоВДокументе,	|	ВТ.Сумма КАК СуммаВДокументе,	|	ОстаткиПартий.Партия КАК Партия,	|	ЕСТЬNULL(ОстаткиПартий.КоличествоОстаток, 0) КАК КоличествоПартии,	|	ЕСТЬNULL(ОстаткиПартий.СтоимостьОстаток, 0) КАК СтоимостьПартии	|ИЗ	|	ВТ_ТоварыДокумента КАК ВТ	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&МоментДО, Товар В (	|		ВЫБРАТЬ 	|			ВТ_ТоварыДокумента.Товар 	|		ИЗ 	|			ВТ_ТоварыДокумента)) КАК ОстаткиПартий 	|	ПО ВТ.Товар = ОстаткиПартий.Товар 	|ИТОГИ	|	СУММА(КоличествоПартии)	|ПО	|	Товар	|УПОРЯДОЧИТЬ ПО	|	Товар,	|	ОстаткиПартий.Партия.Дата ВОЗР";		Запрос.УстановитьПараметр("МоментДО", Новый Граница(МоментВремени(), ВидГраницы.Исключая));	РезультатЗапроса = Запрос.Выполнить();	ВыборкаТоваров = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	#КонецОбласти		#Область РаспределениеПартийИКонтрольОстатков	Пока ВыборкаТоваров.Следующий() Цикл				Если КонтролироватьОстатки И ВыборкаТоваров.КоличествоВДокументе > ВыборкаТоваров.КоличествоПартии Тогда						Нехватка = ВыборкаТоваров.КоличествоВДокументе - ВыборкаТоваров.КоличествоПартии;						Сообщение = Новый СообщениеПользователю;			Сообщение.Текст = "Недостаточно товара " + ВыборкаТоваров.Товар + "! Не хватает: " + Нехватка;			Сообщение.Сообщить(); 						Отказ = Истина;			Продолжить;		КонецЕсли;				КоличествоКСписанию = ВыборкаТоваров.КоличествоВДокументе;		НакопленнаяСебестоимость = 0;				ВыборкаПартий = ВыборкаТоваров.Выбрать();		Пока ВыборкаПартий.Следующий() И КоличествоКСписанию > 0 Цикл						ОстатокВПартии = ВыборкаПартий.КоличествоПартии;			СтоимостьВПартии = ВыборкаПартий.СтоимостьПартии;						Если ОстатокВПартии <= 0 Тогда				Продолжить;			КонецЕсли;						ВзятьИзПартии = Мин(КоличествоКСписанию, ОстатокВПартии);						Если ВзятьИзПартии = ОстатокВПартии Тогда				СписываемаяСтоимость = СтоимостьВПартии;			Иначе				СписываемаяСтоимость = (СтоимостьВПартии / ОстатокВПартии) * ВзятьИзПартии;			КонецЕсли;						ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();			ДвижениеОстатки.Период = Дата;			ДвижениеОстатки.Товар = ВыборкаТоваров.Товар;			ДвижениеОстатки.Партия = ВыборкаПартий.Партия;			ДвижениеОстатки.Количество = ВзятьИзПартии;			ДвижениеОстатки.Стоимость = СписываемаяСтоимость;						НакопленнаяСебестоимость = НакопленнаяСебестоимость + СписываемаяСтоимость;			КоличествоКСписанию = КоличествоКСписанию - ВзятьИзПартии;					КонецЦикла;				Если КоличествоКСписанию > 0 Тогда			ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();			ДвижениеОстатки.Период = Дата;			ДвижениеОстатки.Товар = ВыборкаТоваров.Товар;			ДвижениеОстатки.Количество = КоличествоКСписанию;		КонецЕсли;				ДвижениеПродажи = Движения.Продажи.Добавить();		ДвижениеПродажи.Период = Дата;		ДвижениеПродажи.Товар = ВыборкаТоваров.Товар;		ДвижениеПродажи.Контрагент = Контрагент;		ДвижениеПродажи.Количество = ВыборкаТоваров.КоличествоВДокументе;		ДвижениеПродажи.Сумма = ВыборкаТоваров.СуммаВДокументе; 		ДвижениеПродажи.Себестоимость = НакопленнаяСебестоимость; 			КонецЦикла;	#КонецОбластиКонецПроцедуры