	Процедура ОбработкаПроведения(Отказ, РежимПроведения)		
		Движения.ОстаткиТоваров.Записывать = Истина;
		Движения.Продажи.Записывать = Истина;
		
		Движения.ОстаткиТоваров.Записать();
		Движения.Продажи.Записать();
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
	    |       ОстаткиТоваровОстатки.Товар КАК Товар,
	    |       ОстаткиТоваровОстатки.Партия КАК Партия,
	    |       ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток,
	    |       ОстаткиТоваровОстатки.СтоимостьОстаток КАК СтоимостьОстаток
        |ИЗ
	    |       РегистрНакопления.ОстаткиТоваров.Остатки(&Период, Товар = &Товар) КАК ОстаткиТоваровОстатки
        |
        |УПОРЯДОЧИТЬ ПО
	    |       Товар ВОЗР,
	    |       ОстаткиТоваровОстатки.Партия.Дата ВОЗР";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Период", МоментВремени());						Для Каждого ТекСтрокаТовары Из Товары Цикл
			КоличествоКСписанию = ТекСтрокаТовары.Количество;
			Запрос.УстановитьПараметр("Товар", ТекСтрокаТовары.Товар);
			ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
			СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(Новый Структура ("Товар", ТекСтрокаТовары.Товар));
			ОбщийОстаток = 0;
			
			
		Для Каждого СтрокаОстатка Из СтрокиОстатков Цикл
			ОбщийОстаток = ОбщийОстаток + СтрокаОстатка.КоличествоОстаток;
		КонецЦикла; 
		
		Если ОбщийОстаток < КоличествоКСписанию Тогда
			Сообщить("Недостаточно товара " + ТекСтрокаТовары.Товар +
			"! Не хватает: " +(КоличествоКСписанию - ОбщийОстаток));
			Отказ = Истина; 			
			Продолжить; 
			
		КонецЕсли;
		
		// Если товара хватает, начинаем списывать его по партиям
		
		Для Каждого СтрокаОстатка Из СтрокиОстатков Цикл
			
		Если КоличествоКСписанию = 0 Тогда
				Прервать; 
			
		КонецЕсли;
		
		// Выбираем, сколько взять из текущей партии
		ВзятьИзПартии = Мин(КоличествоКСписанию, СтрокаОстатка.КоличествоОстаток);
		
		Если СтрокаОстатка.КоличествоОстаток > 0 Тогда
		        СписываемаяСтоимость = (СтрокаОстатка.СтоимостьОстаток / СтрокаОстатка.КоличествоОстаток) * ВзятьИзПартии;
			Иначе 
				СписываемаяСтоимость = 0;
		КонецЕсли;
		
		// Регистр ОстатковТоваров 			
		Движение = Движения.ОстаткиТоваров.ДобавитьРасход(); 
		Движение.Период = Дата; 			
		Движение.Товар = ТекСтрокаТовары.Товар; 			
		Движение.Партия = СтрокаОстатка.Партия; 			
		Движение.Количество = ВзятьИзПартии; 			
		Движение.Стоимость = СписываемаяСтоимость; 
		
		 			
		СтрокаОстатка.КоличествоОстаток = СтрокаОстатка.КоличествоОстаток - ВзятьИзПартии; 			
		СтрокаОстатка.СтоимостьОстаток = СтрокаОстатка.СтоимостьОстаток - СписываемаяСтоимость;
		 			
		КоличествоКСписанию = КоличествоКСписанию - ВзятьИзПартии; 
		
		КонецЦикла;
		
				
		// Регистр Продажи 			Движение = Движения.Продажи.Добавить();		Движение.Период = Дата;		Движение.Товар = ТекСтрокаТовары.Товар;		Движение.Контрагент = Контрагент;		Движение.Количество = ТекСтрокаТовары.Количество;			
		КонецЦикла;					КонецПроцедуры