
	// Выдача списка товаров и текущих остатков в формате JSON (GET-запрос)Функция ТоварыПолучитьТовары(Запрос)		Ответ = Новый HTTPСервисОтвет(200);	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");		ЗапросБД = Новый Запрос;	ЗапросБД.Текст = 	"ВЫБРАТЬ	|	Товары.Код КАК Код,	|	Товары.Наименование КАК Наименование,	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток	|ИЗ	|	Справочник.Товары КАК Товары	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки	|	ПО Товары.Ссылка = Остатки.Товар	|ГДЕ	|	НЕ Товары.ПометкаУдаления";		Результат = ЗапросБД.Выполнить().Выбрать();	МассивТоваров = Новый Массив;		Пока Результат.Следующий() Цикл		СтрокаJSON = Новый Структура;		СтрокаJSON.Вставить("code", СокрЛП(Результат.Код));		СтрокаJSON.Вставить("name", СокрЛП(Результат.Наименование));		СтрокаJSON.Вставить("stock", Результат.Остаток);		МассивТоваров.Добавить(СтрокаJSON);	КонецЦикла;		ДанныеОтвета = Новый Структура("status, count, items", "ok", МассивТоваров.Количество(), МассивТоваров);		ЗаписьJSON = Новый ЗаписьJSON;	ЗаписьJSON.УстановитьСтроку();	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);	ТекстJSON = ЗаписьJSON.Закрыть();		Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);	Возврат Ответ;	КонецФункции// Приём новых товаров из внешней системы в формате JSON (POST-запрос)Функция ТоварыЗагрузитьТовары(Запрос)		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);		Если ПустаяСтрока(ТелоЗапроса) Тогда		Ответ = Новый HTTPСервисОтвет(400);		Ответ.УстановитьТелоИзСтроки("{""status"": ""error"", ""message"": ""Пустое тело запроса""}", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);		Возврат Ответ;	КонецЕсли;		Попытка		ЧтениеJSON = Новый ЧтениеJSON;		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);		ВходящиеДанные = ПрочитатьJSON(ЧтениеJSON);		ЧтениеJSON.Закрыть();				СозданоЗаписей = 0;		Если ТипЗнч(ВходящиеДанные) = Тип("Массив") Тогда			Для Каждого Элемент Из ВходящиеДанные Цикл				ИмяТовара = ?(Элемент.Свойство("name"), Элемент.name, "");				Если Не ПустаяСтрока(ИмяТовара) Тогда					Существующий = Справочники.Товары.НайтиПоНаименованию(ИмяТовара, Истина);					Если Существующий.Пустая() Тогда						НовыйТовар = Справочники.Товары.СоздатьЭлемент();						НовыйТовар.Наименование = ИмяТовара;						НовыйТовар.Записать();						СозданоЗаписей = СозданоЗаписей + 1;					КонецЕсли;				КонецЕсли;			КонецЦикла;		КонецЕсли;				РезультатСтруктура = Новый Структура("status, created", "ok", СозданоЗаписей);		ЗаписьJSON = Новый ЗаписьJSON;		ЗаписьJSON.УстановитьСтроку();		ЗаписатьJSON(ЗаписьJSON, РезультатСтруктура);				Ответ = Новый HTTPСервисОтвет(200);		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);		Возврат Ответ;			Исключение		Ответ = Новый HTTPСервисОтвет(400);		Ответ.УстановитьТелоИзСтроки("{""status"": ""error"", ""message"": ""Некорректный JSON""}", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);		Возврат Ответ;	КонецПопытки;	КонецФункции
