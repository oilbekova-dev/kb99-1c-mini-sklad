&НаКлиентеПроцедура ПриОткрытии(Отказ)	ВходящийJSON = "[" + Символы.ПС +	"  {""name"": ""Карандаш чернографитный HB""}," + Символы.ПС +	"  {""name"": ""Степлер металлический №24""}" + Символы.ПС +	"]";КонецПроцедуры&НаКлиентеПроцедура ПолучитьJSON(Команда)	ИсходящийJSON = СформироватьJSONТоваровНаСервере();КонецПроцедуры&НаСервереФункция СформироватьJSONТоваровНаСервере()	ЗапросБД = Новый Запрос;	ЗапросБД.Текст = 	"ВЫБРАТЬ	|	Товары.Код КАК Код,	|	Товары.Наименование КАК Наименование,	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток	|ИЗ	|	Справочник.Товары КАК Товары	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки	|	ПО Товары.Ссылка = Остатки.Товар	|ГДЕ	|	НЕ Товары.ПометкаУдаления";		Результат = ЗапросБД.Выполнить().Выбрать();	МассивТоваров = Новый Массив;		Пока Результат.Следующий() Цикл		СтрокаJSON = Новый Структура;		СтрокаJSON.Вставить("code", СокрЛП(Результат.Код));		СтрокаJSON.Вставить("name", СокрЛП(Результат.Наименование));		СтрокаJSON.Вставить("stock", Результат.Остаток);		МассивТоваров.Добавить(СтрокаJSON);	КонецЦикла;		ДанныеОтвета = Новый Структура("status, count, items", "ok", МассивТоваров.Количество(), МассивТоваров);		ЗаписьJSON = Новый ЗаписьJSON;	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);	Возврат ЗаписьJSON.Закрыть();КонецФункции&НаКлиентеПроцедура ОтправитьJSON(Команда)	ОтветСервераJSON = ЗагрузитьJSONТоваровНаСервере(ВходящийJSON);КонецПроцедуры&НаСервереФункция ЗагрузитьJSONТоваровНаСервере(ТекстJSON)	Если ПустаяСтрока(ТекстJSON) Тогда		Возврат "{""status"": ""error"", ""message"": ""Пустое тело запроса""}";	КонецЕсли;		Попытка		ЧтениеJSON = Новый ЧтениеJSON;		ЧтениеJSON.УстановитьСтроку(ТекстJSON);		ВходящиеДанные = ПрочитатьJSON(ЧтениеJSON);		ЧтениеJSON.Закрыть();				СозданоЗаписей = 0;		Если ТипЗнч(ВходящиеДанные) = Тип("Массив") Тогда			Для Каждого Элемент Из ВходящиеДанные Цикл				ИмяТовара = ?(Элемент.Свойство("name"), Элемент.name, "");				Если Не ПустаяСтрока(ИмяТовара) Тогда					Существующий = Справочники.Товары.НайтиПоНаименованию(ИмяТовара, Истина);					Если Существующий.Пустая() Тогда						НовыйТовар = Справочники.Товары.СоздатьЭлемент();						НовыйТовар.Наименование = ИмяТовара;						НовыйТовар.Записать();						СозданоЗаписей = СозданоЗаписей + 1;					КонецЕсли;				КонецЕсли;			КонецЦикла;		КонецЕсли;				РезультатСтруктура = Новый Структура("status, created", "ok", СозданоЗаписей);		ЗаписьJSON = Новый ЗаписьJSON;		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);		ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);		ЗаписатьJSON(ЗаписьJSON, РезультатСтруктура);		Возврат ЗаписьJSON.Закрыть();			Исключение		Возврат "{""status"": ""error"", ""message"": ""Некорректный формат JSON""}";	КонецПопытки;КонецФункции